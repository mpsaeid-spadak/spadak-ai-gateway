{
  "$schema": "https://opencode.ai/config.json",
  "model": "spadak/auto",
  "provider": {
    "spadak": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spadak AI Gateway (local)",
      "options": {
        "baseURL": "http://127.0.0.1:3001/v1"
      },
      "models": {
        "auto": {
          "name": "Spadak AI Gateway Auto Router",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  }
}
